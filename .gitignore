# =============================================================================
# GitHub AI Actions — .gitignore
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/

# Turborepo cache
.turbo/

# Test coverage
coverage/
*.lcov
.nyc_output/

# TypeScript
*.tsbuildinfo

# Environment variables — NEVER commit secrets!
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor directories
.idea/
.vscode/extensions.json
*.swp
*.swo
*~

# Optional: VS Code settings (keep launch.json and settings shared)
# .vscode/

# pnpm
.pnpm-store/

# Misc
*.pid
*.seed
*.pid.lock
.cache/
tmp/
temp/

# Changesets
# .changeset/ — keep this, it's tracked

# Bundle analyzer
bundle-analyzer-report.html
stats.json
