# pnpm configuration
# https://pnpm.io/npmrc

# Always use exact versions for security
save-exact=true

# Require pnpm (prevents accidental npm/yarn use)
engine-strict=true

# Hoist packages needed for tools (ESLint, TypeScript) to root
hoist-pattern[]=*eslint*
hoist-pattern[]=*prettier*
hoist-pattern[]=*typescript*
hoist-pattern[]=*vitest*
hoist-pattern[]=*@types/*

# Prevent phantom dependencies
node-linker=isolated

# Link workspace packages
link-workspace-packages=true

# Strict peer dependencies
strict-peer-dependencies=false
auto-install-peers=true

# Registry
registry=https://registry.npmjs.org/

# Cache
store-dir=~/.pnpm-store
