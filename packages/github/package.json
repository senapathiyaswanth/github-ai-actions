{
  "name": "@github-ai-actions/github",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub API wrappers and utilities",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "lint:fix": "eslint src tests --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@github-ai-actions/utils": "workspace:*",
    "@octokit/rest": "^21.0.2",
    "@octokit/types": "^13.6.2"
  },
  "devDependencies": {
    "@github-ai-actions/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^2.1.8",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
